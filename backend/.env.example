# Backend Environment Variables Template (Zero Secrets)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expense_manager?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Optional AI Key (Google Gemini Free Tier or offline local fallback)
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
